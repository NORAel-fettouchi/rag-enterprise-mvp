# ===== CONFIGURATION EMBEDDINGS =====
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ===== CONFIGURATION CHUNKING =====
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ===== CONFIGURATION RETRIEVAL =====
TOP_K=5
SIMILARITY_THRESHOLD=0.1

# ===== CONFIGURATION LLM (HuggingFace Inference API) =====
# Type de LLM: huggingface (Ollama n'est plus supporté)
LLM_TYPE=huggingface
# Modèle instruct léger et fiable disponible sur HuggingFace Inference API
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Clé API HuggingFace (obligatoire) - https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# URL de l'API d'inférence HuggingFace (endpoint OpenAI-compatible routé)
HUGGINGFACE_INFERENCE_URL=https://router.huggingface.co/v1/chat/completions
# Paramètres de génération
LLM_TEMPERATURE=0.1
LLM_MAX_NEW_TOKENS=512
LLM_TIMEOUT=120

# ===== CONFIGURATION PATHS =====
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
VECTORSTORE_DIR=vectorstore/index

# ===== CONFIGURATION APP =====
APP_TITLE=RAG Documentaire d'Entreprise
DEBUG_MODE=False
LOG_LEVEL=INFO

# ===== CONFIGURATION PERFORMANCE =====
BATCH_SIZE=32
NUM_WORKERS=4